# Copy to .env and fill in real values. Never commit .env to Git.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DATABASE_URL=postgres://postgres:Rony125921@localhost:5432/smart_hospital
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# AI provider selection (AI-09): "local" is the built-in rule engine and the
# safe default. A hosted LLM provider name may be configured here only after
# explicit product approval; unknown/misconfigured names fall back to local.
AI_PROVIDER=local
